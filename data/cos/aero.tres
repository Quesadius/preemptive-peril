[gd_resource type="Resource" script_class="COProfile" format=3]

[ext_resource type="Script" path="res://data/schema/co_power.gd" id="1_pow"]
[ext_resource type="Script" path="res://data/schema/co_profile.gd" id="2_co"]

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_pow")
key = &"tailwind"
display_name = "Tailwind"
description = "+1 movement, +20% attack, +10% defense."
