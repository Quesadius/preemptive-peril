display_name = "Firestorm"
description = "+2 indirect range, +35% attack, +15% defense."
meter_cost = 600
attack_bonus = 35
defense_bonus = 15
indirect_range_bonus = 2

[resource]
script = ExtResource("2_co")
key = &"nova"
display_name = "Nova"
description = "Siege specialist: +25% indirect firepower, -10% direct combat. Powers extend range."
passive_direct_attack_bonus = -10
passive_indirect_attack_bonus = 25
power = SubResource("Resource_p1")
super_power = SubResource("Resource_p2")
