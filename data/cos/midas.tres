[gd_resource type="Resource" script_class="COProfile" format=3]

[ext_resource type="Script" path="res://data/schema/co_power.gd" id="1_pow"]
[ext_resource type="Script" path="res://data/schema/co_profile.gd" id="2_co"]

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_pow")
key = &"war_chest"
display_name = "War Chest"
description = "+10% attack/defense and instant +50% daily income."
meter_cost = 300
attack_bonus = 10
defense_bonus = 10
bonus_funds_percent = 50

[sub_resource type="Resource" id="Resource_p2"]
script = ExtResource("1_pow")
key = &"golden_surge"
display_name = "Golden Surge"
description = "+20% attack/defense and instant +100% daily income."
meter_cost = 600
attack_bonus = 20
defense_bonus = 20
bonus_funds_percent = 100

[resource]
script = ExtResource("2_co")
key = &"midas"
display_name = "Midas"
description = "Quartermaster: units cost 15% less, -10% attack. Powers inject emergency funds."
passive_attack_bonus = -10
cost_percent = 85
power = SubResource("Resource_p1")
super_power = SubResource("Resource_p2")
