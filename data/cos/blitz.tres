[gd_resource type="Resource" script_class="COProfile" format=3]

[ext_resource type="Script" path="res://data/schema/co_power.gd" id="1_pow"]
[ext_resource type="Script" path="res://data/schema/co_profile.gd" id="2_co"]

[sub_resource type="Resource" id="Resource_p1"]
script = ExtResource("1_pow")
key = &"overdrive"
display_name = "Overdrive"
description = "+1 movement, +15% attack, +10% defense."
meter_cost = 300
attack_bonus = 15
defense_bonus = 10
movement_bonus = 1

[sub_resource type="Resource" id="Resource_p2"]
script = ExtResource("1_pow")
key = &"lightning_strike"
display_name = "Lightning Strike"
description = "+2 movement, +20% attack, and refreshes all acted units!"
meter_cost = 600
attack_bonus = 20
defense_bonus = 10
movement_bonus = 2
refresh_units = true

[resource]
script = ExtResource("2_co")
key = &"blitz"
display_name = "Blitz"
description = "Spearhead rusher: +15% direct attack, -10% indirects. Super refreshes acted units!"
passive_defense_bonus = -5
passive_direct_attack_bonus = 15
passive_indirect_attack_bonus = -10
power = SubResource("Resource_p1")
super_power = SubResource("Resource_p2")
